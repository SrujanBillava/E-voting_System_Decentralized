# VoteChain V3 IDENTITY service. Copy to .env for local development; production passes real environment variables.
# Every value is validated at startup (src/config/env.js); the process refuses to start on any problem.
# This process holds ONE chain key (the commitment issuer). It REFUSES TO START if it finds the relayer's key, the owner key, trustee keys,
# any RELAY_* setting, or V2's JWT/nullifier secrets in its environment.

NODE_ENV=development
PORT=5100                       # served on 127.0.0.1 only; put it behind id.votechain.<domain>
# LOG_LEVEL=info

# The identity store. It must NOT be the relayer's database (a name containing "relay" is refused) and has no default.
# The voter registry (collection voters_v2) and the enrolled faces (facetemplates) are V2's collections: this database must contain them.
IDENTITY_MONGODB_URI=mongodb://127.0.0.1:27017/votechain_identity_v3

CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337                  # required; 31337 is refused in production
VOTECHAIN_V3_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# ELECTION_ID=0x...             # optional: asserted against the contract at startup
# CHAIN_CONFIRMATIONS=1

# The issuer key: it must be the contract's issuer (setIssuer in Setup) and must differ from the owner, the relayer and the trustees.
# Never commit a real key. A publicly known Hardhat key is refused in production.
ISSUER_PRIVATE_KEY=

# Encrypts the enrolled face templates at rest (AES-256-GCM): exactly 32 random bytes as hex (openssl rand -hex 32). Must be the key V2 enrolled with.
FACE_TEMPLATE_ENCRYPTION_KEY=

# LOGIN_RATE_LIMIT_MAX=10       # logins per 15 minutes per source address; raise it for a polling booth whose voters all log in from one kiosk
# FACE_RATE_LIMIT_MAX=60        # face requests per minute per source address
# BATCH_MAX_SIZE=128            # at most the contract's MAX_BATCH (128)
# BATCH_INTERVAL_MS=2000        # how often the epoch batcher looks for a closed cohort

# Exact browser origins allowed to call the API with cookies (comma separated; no wildcard). Required in production.
# CORS_ORIGINS=https://kiosk.votechain.example
