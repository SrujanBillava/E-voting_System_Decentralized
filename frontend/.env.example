# VoteChain frontend. The browser talks ONLY to the VoteChain HTTP API; it never contacts the blockchain.
#
# Base path of the API as seen by the browser. Keep it same-origin (the default) so the HttpOnly session cookies are first-party.
# VITE_API_BASE=/api/v1
#
# Development only: where `npm run dev` proxies /api to.
# VITE_PROXY_TARGET=http://localhost:5000
