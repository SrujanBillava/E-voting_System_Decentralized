# VoteChain V3 ANONYMOUS RELAYER. Copy to .env for local development; production passes real environment variables.
# This process holds ONE chain key (the relayer's gas key) and NOTHING of the identity side. It REFUSES TO START if it finds the issuer key,
# the owner key, trustee keys, any IDENTITY_/FACE_/JWT_/SESSION_/VOTER_/COOKIE_ setting, or the shared MONGODB_URI in its environment.

NODE_ENV=development
PORT=5200                       # served on 127.0.0.1 only; put it behind relay.votechain.<domain>
# LOG_LEVEL=info

# The relayer's OWN store. The database name must contain "relay" (the identity service's database is refused); there is no default.
RELAY_MONGODB_URI=mongodb://127.0.0.1:27017/votechain_relay_v3

CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337                  # required; 31337 is refused in production
VOTECHAIN_V3_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# ELECTION_ID=0x...             # optional: asserted against the contract at startup
# CHAIN_CONFIRMATIONS=1

# The relayer's gas key: it must differ from the contract's issuer, owner and trustees (checked at startup). A publicly known Hardhat key is refused in production.
RELAYER_PRIVATE_KEY=

# A budget for the whole process per minute. There is deliberately no per-client limit: this process does not look at who is calling.
# RELAY_GLOBAL_LIMIT_PER_MINUTE=600

# Exact browser origins allowed to call the API (comma separated; no wildcard). Cookies are never read, so credentials are never allowed. Required in production.
# CORS_ORIGINS=https://kiosk.votechain.example
