# VoteChain backend configuration. Copy to .env (or run `npm run init:env` for local development).
# Every value is validated at startup (src/config/env.js); the process refuses to start on any problem.

NODE_ENV=development
PORT=5000
# LOG_LEVEL=info

# MongoDB. There is deliberately no default database. Replica sets and mongodb+srv:// URIs are accepted:
#   mongodb://a.example.org:27017,b.example.org:27017/evoting?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/evoting

# Blockchain
CHAIN_RPC_URL=http://127.0.0.1:8545
# Deployment coordinates. REQUIRED in production. In development they may be left unset: the backend
# then reads ../smart-contract/deployments/local.json (written by `npm run deploy:local` there).
# If set here they are authoritative, and a contradicting local.json makes startup fail.
# CHAIN_ID=31337
# VOTING_CONTRACT_ADDRESS=0x...
# ELECTION_ID=0x...
# DEPLOYMENT_METADATA_PATH=
# Blocks (the one containing the vote included) before a ballot is reported final. 1 is right for the local Hardhat chain.
# CHAIN_CONFIRMATIONS=1

# Three DIFFERENT server-side keys. They must match the contract's owner / authority / relayer.
# Never commit real keys. `npm run init:env` fills these with public Hardhat dev keys for local use only
# (rejected when NODE_ENV=production).
OWNER_PRIVATE_KEY=
AUTHORITY_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# >= 32 random bytes as hex:  openssl rand -hex 32
# Changing it mid-election would let voters vote twice. Keep it separate from all signing keys.
NULLIFIER_SECRET=

# Admin authentication: two more independent random secrets (openssl rand -hex 32 each).
# JWT_ACCESS_SECRET signs 15-minute admin access tokens; ADMIN_TOTP_ENCRYPTION_KEY encrypts each admin's TOTP secret at rest (AES-256-GCM).
# Rotating the JWT secret logs every admin out. LOSING the encryption key makes every admin's TOTP unusable (re-create admins).
JWT_ACCESS_SECRET=
ADMIN_TOTP_ENCRYPTION_KEY=

# Exact browser origins allowed to call the API (comma separated; no wildcard, no trailing slash).
# Required in production. Development default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://vote.example.org
